{
  "$description": "Now or Later brand tokens. Source of truth for app/styles.css and the native app's asset catalog. Guide: https://claude.ai/artifact/EZtHFJbGomCacRv1VkaScQ",
  "version": "0.1.0",
  "color": {
    "brand": {
      "ballpoint": { "light": "#2F5BD3", "dark": "#7FA2FF", "onLight": "#FFFFFF", "onDark": "#12161C" },
      "margin":    { "light": "#D9534F", "dark": "#E2706C" },
      "marigold":  { "light": "#F2B84B", "dark": "#F2B84B", "on": "#1D2430" }
    },
    "neutral": {
      "desk":   { "light": "#EEF0F3", "dark": "#12161C" },
      "page":   { "light": "#FBFCFD", "dark": "#1B2129" },
      "ink":    { "light": "#1D2430", "dark": "#E8EDF3" },
      "pencil": { "light": "#56616F", "dark": "#ADB7C3" },
      "rule":   { "light": "#CFD8E3", "dark": "#2C3540" },
      "edge":   { "light": "#DDE3EA", "dark": "#2A323C" }
    },
    "semantic": {
      "delete":    { "light": "#C0392B", "dark": "#E2706C" },
      "synced":    "#3AA76D",
      "waiting":   "#E0A030",
      "highlight": { "base": "#F2B84B", "opacity": 0.45 }
    },
    "list": {
      "$description": "Same value in both appearances. Background = 20% over Page, border = 35% into Edge.",
      "marigold":   "#F2B84B",
      "periwinkle": "#7B9CFF",
      "lavender":   "#9B8CF0",
      "mint":       "#5CC6A7",
      "coral":      "#F28B82",
      "peony":      "#F6A6CF",
      "sky":        "#8ECAE6",
      "pear":       "#B5D16B",
      "kraft":      "#C9A27E",
      "tangerine":  "#FF9F5A",
      "lagoon":     "#7FD1D8",
      "pebble":     "#A3A9B5"
    },
    "listDefaults": { "now": "marigold", "tomorrow": "periwinkle", "later": "mint" }
  },
  "font": {
    "display":     { "family": "Bricolage Grotesque", "fallback": ["Avenir Next", "system-ui", "sans-serif"], "weights": [500, 700, 800] },
    "interface":   { "family": "Atkinson Hyperlegible", "fallback": ["system-ui", "-apple-system", "sans-serif"], "weights": [400, 700] },
    "handwriting": { "family": "Kalam", "fallback": ["Bradley Hand", "Segoe Print", "cursive"], "weights": [400] }
  },
  "typeScale": {
    "largeTitle": { "size": 34, "font": "display", "weight": 800 },
    "sheetTitle": { "size": 21, "font": "display", "weight": 700 },
    "listName":   { "size": 20, "font": "display", "weight": 700 },
    "todo":       { "size": 18, "font": "handwriting", "weight": 400 },
    "date":       { "size": 18, "font": "handwriting", "weight": 400 },
    "body":       { "size": 16, "font": "interface", "weight": 400 },
    "control":    { "size": 15, "font": "interface", "weight": 700 },
    "meta":       { "size": 13, "font": "interface", "weight": 400 }
  },
  "radius": { "mark": 4, "checkbox": 6, "page": 8, "list": 14, "capsule": 999 },
  "space":  { "checkboxGap": 6, "tight": 8, "listHeader": 12, "gutter": 16, "boardBottom": 20 },
  "list":   { "width": 300, "phonePeek": 48, "max": 10 },
  "motion": { "tap": "150ms ease-out", "tick": "200ms ease-out", "strike": "250ms ease-out", "dragTilt": "-2deg" },
  "icon": {
    "name": "Margin line",
    "files": "brand/icon/",
    "layers": ["paper.svg", "margin.svg", "tick.svg"]
  }
}
